<?php
// =============================================
// REGISTRATION PAGE - Form with server-side validation
// =============================================

$page_title = 'Register for Event';
require_once 'includes/config.php';
include 'includes/header.php';

// Variables for form
$student_name = $student_id = $email = $selected_event_id = '';
$errors = [];
$success_message = '';

// Pre-select event if ID is passed in URL
if (isset($_GET['event_id']) && !isset($_POST['submit'])) {
    $selected_event_id = (int)$_GET['event_id'];
}

// Get events for dropdown
$events = getEvents();

// Process form submission
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['submit'])) {
    
    // Sanitize and validate inputs
    $student_name = trim($_POST['student_name'] ?? '');
    $student_id = trim($_POST['student_id'] ?? '');
    $email = trim($_POST['email'] ?? '');
    $selected_event_id = (int)($_POST['event_id'] ?? 0);
    
    // Validation
    if (empty($student_name)) {
        $errors[] = 'Student name is required.';
    } elseif (strlen($student_name) < 2) {
        $errors[] = 'Student name must be at least 2 characters.';
    }
    
    if (empty($student_id)) {
        $errors[] = 'Student ID is required.';
    } elseif (!preg_match('/^[0-9]{7,10}$/', $student_id)) {
        $errors[] = 'Student ID must be 7-10 digits.';
    }
    
    if (empty($email)) {
        $errors[] = 'Email address is required.';
    } elseif (!filter_var($email, FILTER_VALIDATE_EMAIL)) {
        $errors[] = 'Please enter a valid email address.';
    }
    
    if ($selected_event_id <= 0) {
        $errors[] = 'Please select a valid event.';
    } else {
        $event = getEventById($selected_event_id);
        if (!$event) {
            $errors[] = 'Selected event does not exist.';
        }
    }
    
    // If no errors, save registration
    if (empty($errors)) {
        $event_title = $event['title'] ?? 'Unknown Event';
        $reg_data = [
            getNextRegistrationId(),
            $student_name,
            $student_id,
            $email,
            $selected_event_id,
            $event_title,
            date('Y-m-d H:i:s')
        ];
        
        if (saveRegistration($reg_data)) {
            $success_message = "✅ Registration successful for <strong>" . htmlspecialchars($event_title) . "</strong>! You will receive a confirmation email at <strong>" . htmlspecialchars($email) . "</strong>.";
            // Reset form fields
            $student_name = $student_id = $email = '';
            $selected_event_id = 0;
        } else {
            $errors[] = 'There was an error saving your registration. Please try again.';
        }
    }
}
?>

<h2 class="page-title">Register for an Event</h2>

<?php if (!empty($errors)): ?>
    <div class="error-box">
        <strong>Please fix the following errors:</strong>
        <ul style="margin-top: 10px; list-style: disc; padding-left: 20px;">
            <?php foreach ($errors as $error): ?>
                <li><?php echo htmlspecialchars($error); ?></li>
            <?php endforeach; ?>
        </ul>
    </div>
<?php endif; ?>

<?php if (!empty($success_message)): ?>
    <div class="success-message">
        <?php echo $success_message; ?>
    </div>
<?php endif; ?>

<div class="form-container">
    <form action="register.php" method="POST">
        <!-- Student Name -->
        <div class="form-group">
            <label for="student_name">Full Name <span class="required">*</span></label>
            <input type="text" id="student_name" name="student_name" 
                   value="<?php echo htmlspecialchars($student_name); ?>" 
                   placeholder="Enter your full name" required>
        </div>
        
        <!-- Student ID -->
        <div class="form-group">
            <label for="student_id">Student ID <span class="required">*</span></label>
            <input type="text" id="student_id" name="student_id" 
                   value="<?php echo htmlspecialchars($student_id); ?>" 
                   placeholder="e.g., 2024123456" required>
            <small style="color: #777;">Enter your 7-10 digit student ID.</small>
        </div>
        
        <!-- Email -->
        <div class="form-group">
            <label for="email">Email Address <span class="required">*</span></label>
            <input type="email" id="email" name="email" 
                   value="<?php echo htmlspecialchars($email); ?>" 
                   placeholder="you@university.edu" required>
        </div>
        
        <!-- Event Selection -->
        <div class="form-group">
            <label for="event_id">Select Event <span class="required">*</span></label>
            <select id="event_id" name="event_id" required>
                <option value="">-- Please select an event --</option>
                <?php foreach ($events as $event): ?>
                    <option value="<?php echo $event['id']; ?>" 
                        <?php echo ($selected_event_id == $event['id']) ? 'selected' : ''; ?>>
                        <?php echo htmlspecialchars($event['title']); ?> 
                        (<?php echo htmlspecialchars($event['date'] ?? 'TBD'); ?>)
                    </option>
                <?php endforeach; ?>
            </select>
        </div>
        
        <!-- Submit Button -->
        <button type="submit" name="submit" class="btn btn-secondary" style="width: 100%;">
            Register Now
        </button>
    </form>
</div>

<?php include 'includes/footer.php'; ?>
